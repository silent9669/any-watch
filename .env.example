# Hosted web service settings. Never commit the real administrator password.
ANY_WATCH_ADMIN_USERNAME=admin
ANY_WATCH_ADMIN_PASSWORD=replace-with-a-long-unique-password
ANY_WATCH_DATA_DIR=./data
ANY_WATCH_SECURE_COOKIES=0
# Optional private Invidious instance used by the dedicated YouTube screen.
ANY_WATCH_INVIDIOUS_URL=
ANY_WATCH_INVIDIOUS_LOCAL_PROXY=1
PORT=3000

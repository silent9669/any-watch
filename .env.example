# Hosted web service settings. Never commit the real administrator password.
ANY_WATCH_ADMIN_USERNAME=admin
ANY_WATCH_ADMIN_PASSWORD=replace-with-a-long-unique-password
ANY_WATCH_DATA_DIR=./data
ANY_WATCH_TORRENT_DOWNLOAD_DIR=./data/downloads_tmp
ANY_WATCH_SECURE_COOKIES=0
# Optional explicit server config file; hosted mode otherwise uses safe defaults.
ANY_WATCH_CONFIG_PATH=
# Optional comma-separated provider overrides, for example:
# anizone=true,moviebox=false,allanime=false
ANY_WATCH_PROVIDER_OVERRIDES=
# Optional private or trusted Invidious instance used by the YouTube screen.
ANY_WATCH_INVIDIOUS_URL=
ANY_WATCH_INVIDIOUS_LOCAL_PROXY=1
PORT=3000
# Optional Vite development proxy when the API does not run on port 3000.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

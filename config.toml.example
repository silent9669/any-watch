# any-watch configuration file
# Place this file at:
#   macOS: ~/Library/Application Support/com.silent9669.any-watch/config.toml
#   Windows: %APPDATA%\com.silent9669.any-watch\config.toml
#   Linux: ~/.config/any-watch/config.toml

[sources]
# Keep YouTube separate from language-based anime search. The hosted web server
# enables it when ANY_WATCH_INVIDIOUS_URL is set.
invidious = false

# ani-cli v5 compatible English HLS source.
anidb = true

# English soft-sub HLS source. ASS tracks are converted to WebVTT by the web
# server. Disabled by default until its challenge-prone upstream is explicitly
# certified from the deployment network.
anizone = false

# AllAnime is challenge-gated upstream; keep disabled until a documented
# browser-safe integration passes certification.
allanime = false

# Live-certified English source.
animegg = true

# Signed English-sub series and film streams. Disabled by default because the
# currently resolved DASH variants are HEVC-only and are not browser-portable.
moviebox = false

# Enable KKPhim source (Vietnamese)
kkphim = true

# Enable OPhim source (Vietnamese)
ophim = true

# Legacy duplicate of OPhim. Keep disabled unless testing migration behavior.
animevietsub = false

# Additional documented Vietnamese providers.
# Niniyo is certified through AniMapper's mapped episode and HLS source APIs.
# K20 connects to K20 Phim Tổng Hợp Stremio Addon (NguonC, STP, HH3D, VSMOV, YanHH3D, etc.).
animetvn = false
niniyo = true
k20 = true

# Legacy experimental setting retained for compatibility. The runtime ignores
# it until a maintained upstream passes direct playback certification.
hianime = false

[invidious]
instance_url = "http://invidious:3000"
local_proxy = true

[theme]
primary_color = "#FF2934"
secondary_color = "#39C7D5"

ANY_WATCH_DOMAIN=ani.dangphuc.me
ANY_WATCH_ADMIN_USERNAME=admin
ANY_WATCH_ADMIN_PASSWORD=replace-with-a-long-random-password
ANY_WATCH_DATA_PATH=/srv/any-watch/data
ANY_WATCH_TORRENT_DOWNLOAD_DIR=/data/downloads_tmp

# Copy to .env.homelab and keep that real file private.
ANY_WATCH_ADMIN_USERNAME=family-admin
ANY_WATCH_ADMIN_PASSWORD=replace-with-at-least-20-random-characters
ANY_WATCH_SECURE_COOKIES=1
ANY_WATCH_TORRENT_DOWNLOAD_DIR=/data/downloads_tmp
# Optional config file inside the container, for example /data/config.toml.
ANY_WATCH_CONFIG_PATH=
# Optional: anizone=true,moviebox=false,allanime=false
ANY_WATCH_PROVIDER_OVERRIDES=
# Required for the YouTube screen. Use a private or trusted reachable instance.
ANY_WATCH_INVIDIOUS_URL=
ANY_WATCH_INVIDIOUS_LOCAL_PROXY=1
RUST_LOG=any_watch_server=info,tower_http=info
